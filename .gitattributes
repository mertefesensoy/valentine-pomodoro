# The art pipeline compares rebuilt exports byte for byte (scripts/art/build.mjs --check),
# so its outputs must reach every checkout exactly as VectorCraft wrote them: no line-ending
# conversion, whatever core.autocrlf says (Stage C record §2.3).
art/vc/** -text
art/out/** -text
art/steps/** -text
art/src/** -text
art/jobs/** -text
# The brand kit is checked the same way (python brand/tools/check_brand.py --rebuild).
brand/svg/** -text
brand/png/** -text
brand/pdf/** -text
brand/eps/** -text
brand/source/** -text
brand/web/** -text
brand/guide/** -text

# The embedded fonts and their licence are compared byte for byte too
# (python -P art/type/build-fonts.py --check; Phase 1 D1).
assets/fonts/** -text
