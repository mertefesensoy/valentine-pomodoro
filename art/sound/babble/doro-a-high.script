# Doro's babble, the "a" syllable, high.
# A4 (440 Hz) → B4 (494 Hz) → Bb4 (466 Hz), gliding 60 ms between notes; then it releases.
# Voice: lower and rounder: a triangle with a little saw through a gentler low-pass, rising softly into each note and sighing down a semitone.
#
# Generated by scripts/sound/babble-scripts.mjs; scripts/sound/build.mjs saves art/sound/babble/doro-a-high.scraft from it,
# bounces that session and encodes src/assets/sounds/babble/doro-a-high.m4a. 125 bpm at 960 ticks per quarter: one tick is 0.5 ms.

session.new {"name": "doro-a-high", "sample_rate": 48000, "bit_depth": 24}
event.tempo {"bpm": 125}

# The voice, on a stereo track (SoundCraft 0.14 pans a mono track 6 dB right at centre). The vowel is the
# filter: from 400 Hz with 25 % resonance, its envelope sweeping up and back over the first ~100 ms.
track.new {"kind": "instrument", "format": "stereo", "name": "Voice", "instrument": "subtractive_synth"}
mix.instrument {"track": "Voice", "plugin": "subtractive_synth", "params": {"osc1_wave": 3, "osc2_wave": 0, "osc2_semitones": 0, "osc2_detune": 3, "osc_mix": 30, "filter_attack": 45, "filter_decay": 150, "filter_sustain": 45, "filter_release": 100, "amp_attack": 16, "amp_decay": 70, "amp_sustain": 80, "amp_release": 70, "glide": 60, "cutoff": 400, "resonance": 25, "filter_env_amount": 50, "velocity": 100, "level": -6}}

# Soft: a 150 Hz high-pass, and a 3 kHz low-pass (24 dB/oct) clear of the ear's most sensitive band.
mix.insert {"track": "Voice", "slot": 0, "plugin": "eq_7band", "params": {"hpf_on": 1, "hpf_freq": 150, "hpf_slope": 1, "lpf_on": 1, "lpf_freq": 3000, "lpf_slope": 3}}

# Warmth: D4's plate, smaller and quieter (width 0 keeps the two channels together for the mono fold).
mix.insert {"track": "Voice", "slot": 1, "plugin": "plate_reverb", "params": {"mix": 10, "pre_delay": 8, "decay": 0.4, "size": 25, "damping": 4500, "diffusion": 80, "width": 0, "low_cut": 250}}

# The seed (two ticks at velocity 1, silent) sets where the first glide starts; each note glides from the last.
midi.new_clip {"track": "Voice", "start": 0, "length": 48000}
midi.note_add {"clip": 2, "pitch": 69, "start_ticks": 0, "length_ticks": 2, "velocity": 1}
midi.note_add {"clip": 2, "pitch": 71, "start_ticks": 2, "length_ticks": 140, "velocity": 100}
midi.note_add {"clip": 2, "pitch": 70, "start_ticks": 142, "length_ticks": 140, "velocity": 85}
