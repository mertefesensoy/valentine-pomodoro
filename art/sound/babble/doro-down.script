# Doro's babble, "down" (the line-end syllable): a "u" falling a fifth, for a line's end.
# E5 → A4 (659 → 440 Hz), falling, over a 100 ms glide; the note holds 150 ms, then releases.
# Voice: lower and rounder: a triangle wave with a little square for presence, softer attacks, longer syllables that settle gently onto their note.
#
# Generated by scripts/sound/babble-scripts.mjs; scripts/sound/build.mjs saves art/sound/babble/doro-down.scraft from it,
# bounces that session and encodes src/assets/sounds/babble/doro-down.m4a. 125 bpm at 960 ticks per quarter: one tick is 0.5 ms.

session.new {"name": "doro-down", "sample_rate": 48000, "bit_depth": 24}
event.tempo {"bpm": 125}

# The voice, on a stereo track (SoundCraft 0.14 pans a mono track 6 dB right at centre).
track.new {"kind": "instrument", "format": "stereo", "name": "Voice", "instrument": "subtractive_synth"}
mix.instrument {"track": "Voice", "plugin": "subtractive_synth", "params": {"osc1_wave": 3, "osc2_wave": 1, "osc2_semitones": 0, "osc2_detune": 4, "osc_mix": 20, "filter_attack": 35, "filter_decay": 90, "filter_sustain": 50, "filter_release": 80, "amp_attack": 12, "amp_decay": 60, "amp_sustain": 80, "amp_release": 70, "glide": 100, "cutoff": 750, "resonance": 15, "filter_env_amount": 20, "velocity": 100, "level": -6}}

# The vowel: a 4 dB bell at 750 Hz (Q 1.5); a 200 Hz high-pass and a 4.5 kHz low-pass (24 dB/oct) keep it clean and soft.
mix.insert {"track": "Voice", "slot": 0, "plugin": "eq_7band", "params": {"hpf_on": 1, "hpf_freq": 200, "hpf_slope": 1, "mid_freq": 750, "mid_gain": 4, "mid_q": 1.5, "lpf_on": 1, "lpf_freq": 4500, "lpf_slope": 3}}

# The seed (two ticks at velocity 1, silent) sets where the glide starts; the syllable glides from it.
midi.new_clip {"track": "Voice", "start": 0, "length": 48000}
midi.note_add {"clip": 2, "pitch": 76, "start_ticks": 0, "length_ticks": 2, "velocity": 1}
midi.note_add {"clip": 2, "pitch": 69, "start_ticks": 2, "length_ticks": 300, "velocity": 100}
