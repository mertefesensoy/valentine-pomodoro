# Pomo's babble, "down" (the line-end syllable): an "o" falling a fifth, for the end of a line.
# E5 → A4 (659 → 440 Hz), falling, over a 80 ms glide; the note holds 115 ms, then releases.
# Voice: higher and bouncier: the chime voice (a sine, with a triangle an octave up at 18 %), syllables that spring up a major third into their note.
#
# Generated by scripts/sound/babble-scripts.mjs; scripts/sound/build.mjs saves art/sound/babble/pomo-down.scraft from it,
# bounces that session and encodes src/assets/sounds/babble/pomo-down.m4a. 125 bpm at 960 ticks per quarter: one tick is 0.5 ms.

session.new {"name": "pomo-down", "sample_rate": 48000, "bit_depth": 24}
event.tempo {"bpm": 125}

# The voice, on a stereo track (SoundCraft 0.14 pans a mono track 6 dB right at centre).
track.new {"kind": "instrument", "format": "stereo", "name": "Voice", "instrument": "subtractive_synth"}
mix.instrument {"track": "Voice", "plugin": "subtractive_synth", "params": {"osc1_wave": 2, "osc2_wave": 3, "osc2_semitones": 12, "osc2_detune": 3, "osc_mix": 18, "resonance": 0, "filter_attack": 14, "filter_decay": 70, "filter_sustain": 50, "filter_release": 80, "amp_attack": 10, "amp_decay": 50, "amp_sustain": 70, "amp_release": 70, "glide": 80, "cutoff": 1300, "filter_env_amount": 15, "velocity": 100, "level": -6}}

# The vowel: a 3 dB bell at 800 Hz (Q 1.2), nothing boosted above 1.5 kHz; a 150 Hz high-pass and a
# 3.5 kHz low-pass (24 dB/oct) keep it clean and soft.
mix.insert {"track": "Voice", "slot": 0, "plugin": "eq_7band", "params": {"hpf_on": 1, "hpf_freq": 150, "hpf_slope": 1, "mid_freq": 800, "mid_gain": 3, "mid_q": 1.2, "lpf_on": 1, "lpf_freq": 3500, "lpf_slope": 3}}

# Warmth: D4's plate, smaller and quieter (width 0 keeps the two channels together for the mono fold).
mix.insert {"track": "Voice", "slot": 1, "plugin": "plate_reverb", "params": {"mix": 10, "pre_delay": 8, "decay": 0.4, "size": 25, "damping": 4500, "diffusion": 80, "width": 0, "low_cut": 250}}

# The seed (two ticks at velocity 1, silent) sets where the glide starts; the syllable glides from it.
midi.new_clip {"track": "Voice", "start": 0, "length": 48000}
midi.note_add {"clip": 2, "pitch": 76, "start_ticks": 0, "length_ticks": 2, "velocity": 1}
midi.note_add {"clip": 2, "pitch": 69, "start_ticks": 2, "length_ticks": 230, "velocity": 100}
