# Pomo's babble, the "e" or "i" syllable, high.
# C#5 (554 Hz) → F#5 (740 Hz) → E5 (659 Hz), gliding 40 ms between notes; then it releases.
# Voice: higher and bouncier: a saw with a triangle through a resonant low-pass, springing up past each note and settling.
#
# Generated by scripts/sound/babble-scripts.mjs; scripts/sound/build.mjs saves art/sound/babble/pomo-e-high.scraft from it,
# bounces that session and encodes src/assets/sounds/babble/pomo-e-high.m4a. 125 bpm at 960 ticks per quarter: one tick is 0.5 ms.

session.new {"name": "pomo-e-high", "sample_rate": 48000, "bit_depth": 24}
event.tempo {"bpm": 125}

# The voice, on a stereo track (SoundCraft 0.14 pans a mono track 6 dB right at centre). The vowel is the
# filter: from 520 Hz with 30 % resonance, its envelope sweeping up and back over the first ~100 ms.
track.new {"kind": "instrument", "format": "stereo", "name": "Voice", "instrument": "subtractive_synth"}
mix.instrument {"track": "Voice", "plugin": "subtractive_synth", "params": {"osc1_wave": 0, "osc2_wave": 3, "osc2_semitones": 0, "osc2_detune": 4, "osc_mix": 50, "filter_attack": 30, "filter_decay": 110, "filter_sustain": 35, "filter_release": 80, "amp_attack": 10, "amp_decay": 50, "amp_sustain": 70, "amp_release": 45, "glide": 40, "cutoff": 520, "resonance": 30, "filter_env_amount": 55, "velocity": 100, "level": -6}}

# Soft: a 150 Hz high-pass, and a 3 kHz low-pass (24 dB/oct) clear of the ear's most sensitive band.
mix.insert {"track": "Voice", "slot": 0, "plugin": "eq_7band", "params": {"hpf_on": 1, "hpf_freq": 150, "hpf_slope": 1, "lpf_on": 1, "lpf_freq": 3000, "lpf_slope": 3}}

# Warmth: D4's plate, smaller and quieter (width 0 keeps the two channels together for the mono fold).
mix.insert {"track": "Voice", "slot": 1, "plugin": "plate_reverb", "params": {"mix": 10, "pre_delay": 8, "decay": 0.4, "size": 25, "damping": 4500, "diffusion": 80, "width": 0, "low_cut": 250}}

# The seed (two ticks at velocity 1, silent) sets where the first glide starts; each note glides from the last.
midi.new_clip {"track": "Voice", "start": 0, "length": 48000}
midi.note_add {"clip": 2, "pitch": 73, "start_ticks": 0, "length_ticks": 2, "velocity": 1}
midi.note_add {"clip": 2, "pitch": 78, "start_ticks": 2, "length_ticks": 90, "velocity": 100}
midi.note_add {"clip": 2, "pitch": 76, "start_ticks": 92, "length_ticks": 110, "velocity": 85}
