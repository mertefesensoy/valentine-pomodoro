# Pomo's babble, "pe": an "e".
# C5 → E5 (523 → 659 Hz), rising, over a 45 ms glide; the note holds 80 ms, then releases.
# Voice: higher and bouncier: a square wave with a little detuned saw, quick attacks, short syllables that spring up into their note.
#
# Generated by scripts/sound/babble-scripts.mjs; scripts/sound/build.mjs saves art/sound/babble/pomo-pe.scraft from it,
# bounces that session and encodes src/assets/sounds/babble/pomo-pe.m4a. 125 bpm at 960 ticks per quarter: one tick is 0.5 ms.

session.new {"name": "pomo-pe", "sample_rate": 48000, "bit_depth": 24}
event.tempo {"bpm": 125}

# The voice, on a stereo track (SoundCraft 0.14 pans a mono track 6 dB right at centre).
track.new {"kind": "instrument", "format": "stereo", "name": "Voice", "instrument": "subtractive_synth"}
mix.instrument {"track": "Voice", "plugin": "subtractive_synth", "params": {"osc1_wave": 1, "osc2_wave": 0, "osc2_semitones": 0, "osc2_detune": 6, "osc_mix": 25, "filter_attack": 18, "filter_decay": 60, "filter_sustain": 40, "filter_release": 60, "amp_attack": 6, "amp_decay": 40, "amp_sustain": 75, "amp_release": 45, "glide": 45, "cutoff": 1500, "resonance": 30, "filter_env_amount": 45, "velocity": 100, "level": -6}}

# The vowel: a 5 dB bell at 2100 Hz (Q 2.5); a 200 Hz high-pass and a 4.5 kHz low-pass (24 dB/oct) keep it clean and soft.
mix.insert {"track": "Voice", "slot": 0, "plugin": "eq_7band", "params": {"hpf_on": 1, "hpf_freq": 200, "hpf_slope": 1, "high_mid_freq": 2100, "high_mid_gain": 5, "high_mid_q": 2.5, "lpf_on": 1, "lpf_freq": 4500, "lpf_slope": 3}}

# The seed (two ticks at velocity 1, silent) sets where the glide starts; the syllable glides from it.
midi.new_clip {"track": "Voice", "start": 0, "length": 48000}
midi.note_add {"clip": 2, "pitch": 72, "start_ticks": 0, "length_ticks": 2, "velocity": 1}
midi.note_add {"clip": 2, "pitch": 76, "start_ticks": 2, "length_ticks": 160, "velocity": 100}
