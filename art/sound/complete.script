# Completion (FR-SET-004): the sticker placement, the product's one delight (DESIGN.md).
# A soft "pop" as the sticker is pressed onto the page, then the chime climbs C5, E5, G5 and lands
# on C6 with E6 above it: the arc focus start opened, finished an octave up.
#
# soundcraft-cli 0.14 script: one `COMMAND JSON` per line. scripts/sound/build.mjs runs it, saves
# art/sound/complete.scraft, then bounces that session with file.bounce_mix.
# 125 bpm at 960 ticks per quarter makes one tick 0.5 ms, so 110 ticks is 55 ms.

session.new {"name": "complete", "sample_rate": 48000, "bit_depth": 24}
event.tempo {"bpm": 125}

# The diary chime (as in focus-start.script). Stereo track: SoundCraft 0.14 pans a mono track
# 6 dB right at centre.
track.new {"kind": "instrument", "format": "stereo", "name": "Chime", "instrument": "subtractive_synth"}
mix.instrument {"track": "Chime", "plugin": "subtractive_synth", "params": {"osc1_wave": 2, "osc2_wave": 3, "osc2_semitones": 12, "osc2_detune": 3, "osc_mix": 22, "cutoff": 2400, "resonance": 0, "filter_env_amount": 25, "filter_attack": 0.5, "filter_decay": 120, "filter_sustain": 0, "filter_release": 200, "amp_attack": 4, "amp_decay": 900, "amp_sustain": 0, "amp_release": 300, "glide": 0, "velocity": 60, "level": -6}}
mix.insert {"track": "Chime", "slot": 0, "plugin": "plate_reverb", "params": {"mix": 16, "pre_delay": 12, "decay": 0.8, "size": 35, "damping": 5000, "diffusion": 85, "width": 0, "low_cut": 250}}

# The pop: drum_synth's high tom (note 50) tuned up nine semitones and cut short, a round "bup"
# under the first chime note rather than a drum hit.
track.new {"kind": "instrument", "format": "stereo", "name": "Pop", "instrument": "drum_synth"}
mix.instrument {"track": "Pop", "plugin": "drum_synth", "params": {"level": -6, "tom_tune": 9, "tom_decay": 90}}
mix.volume {"tracks": ["Pop"], "db": -6}

midi.new_clip {"track": "Chime", "start": 0, "length": 72000}
midi.new_clip {"track": "Pop", "start": 0, "length": 72000}
midi.note_add {"clip": 4, "pitch": 50, "start_ticks": 0, "length_ticks": 200, "velocity": 96}
midi.note_add {"clip": 3, "pitch": 72, "start_ticks": 20, "length_ticks": 600, "velocity": 76}
midi.note_add {"clip": 3, "pitch": 76, "start_ticks": 130, "length_ticks": 600, "velocity": 80}
midi.note_add {"clip": 3, "pitch": 79, "start_ticks": 240, "length_ticks": 600, "velocity": 86}
midi.note_add {"clip": 3, "pitch": 84, "start_ticks": 350, "length_ticks": 1400, "velocity": 100}
midi.note_add {"clip": 3, "pitch": 88, "start_ticks": 350, "length_ticks": 1400, "velocity": 44}
