{
  "name": "valentine-pomodoro",
  "version": "1.3.1",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "lint": "expo lint --no-cache",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:perf": "reassure"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native-stack": "^7.3.16",
    "expo": "^58.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-splash-screen": "~58.0.12",
    "expo-symbols": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "~58.0.0",
    "@react-navigation/native": "^7.1.28",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "patch-package": "^8.0.1",
    "reassure": "^1.6.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ]
  }
}
